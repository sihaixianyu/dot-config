{
  // 差异视图
  "diff_view_style": "unified",
  // Agent
  "agent": {
    "default_model": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  // 键位与启动
  "base_keymap": "VSCode",
  "helix_mode": true,
  "restore_on_startup": "empty_tab",
  // 外观与编辑器
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte Monochrome",
    "dark": "Catppuccin Mocha Monochrome"
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "buffer_font_features": {
    "calt": true
  },
  "minimap": {
    "max_width_columns": 120,
    "show": "always"
  },
  "project_panel": {
    "dock": "left"
  },
  "wrap_guides": [
    120
  ],
  // 终端
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 12
  },
  // 保存与文件
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "file_scan_exclusions": [
    "**/.cache",
    "**/.venv",
    "..."
  ],
  // 语言与语言服务
  "languages": {
    "Go": {
      "inlay_hints": {
        "enabled": true
      }
    },
    "Rust": {
      "inlay_hints": {
        "enabled": true
      }
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "closingBraceHints": {
            "enable": false
          },
          "genericParameterHints": {
            "type": {
              "enable": true
            }
          }
        }
      }
    }
  },
  // 扩展
  "auto_install_extensions": {
    "catppuccin-icons": true,
    "log": true,
    "solarized": true,
    "tokyo-night": true,
    "toml": true
  }
}
